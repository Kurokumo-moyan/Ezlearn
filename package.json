{
  "name": "ezlearn",
  "version": "0.4.1",
  "private": true,
  "description": "通用学习软件：把一门课的教学资料变成可追溯、可交互的学习书（本地单用户 MVP）",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test \"test/*.test.js\"",
    "demo:seed": "node scripts/seed-demo.js",
    "audit": "npm audit --omit=dev",
    "build:installer": "node scripts/build-installer.mjs",
    "fetch:webview2": "node scripts/fetch-webview2.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@napi-rs/canvas": "1.1.0",
    "express": "5.3.0",
    "katex": "0.19.1",
    "multer": "2.5.0",
    "pdfjs-dist": "6.4.299",
    "quickjs-emscripten": "0.32.0",
    "sql.js": "1.15.1",
    "zod": "4.6.7"
  }
}
